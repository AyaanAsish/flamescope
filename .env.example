# FlameScope configuration (document 11 section 3). Copy to .env (make env).

# Database bootstrap (db container)
POSTGRES_USER=flamescope
POSTGRES_PASSWORD=flamescope
POSTGRES_DB=flamescope

# SQLAlchemy URL (api, ingest). Use localhost instead of db for development without containers.
DATABASE_URL=postgresql+psycopg://flamescope:flamescope@db:5432/flamescope

# LLM gateway: mock | ollama. Set LLM_PROVIDER=mock and EMBED_PROVIDER=mock for the offline mode.
LLM_PROVIDER=ollama
# Ollama on the Mac host (http://localhost:11434 for development without containers)
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:0.5b
LLM_TIMEOUT_S=60
# Leave empty to follow LLM_PROVIDER (document 11 section 3)
EMBED_PROVIDER=
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Harvest source (ingest)
PSI_BUCKET=nasa-psi
PSI_REGION=us-west-2
PSI_PREFIX=
HARVEST_MAX_DOC_MB=25
HARVEST_MAX_TABLE_MB=5
HARVEST_MAX_TABLES=20
HARVEST_MAX_TOTAL_MB=300

# Ingest entrypoint command
INGEST_COMMAND=seed

# Paths inside the containers
RAW_DIR=/data/raw
DATA_DIR=/app/src/data

# Citation verifier threshold
VERIFY_MIN_OVERLAP=0.35

# API
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# UI rewrite target
API_INTERNAL_URL=http://api:8000

# Host ports (compose)
API_PORT=8000
UI_PORT=3000
DB_PORT=5432
