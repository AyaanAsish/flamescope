# syntax=docker/dockerfile:1
# FlameScope API image (document 11 section 1). Build context: repository root.
ARG PYTHON_IMAGE=python:3.12-slim

FROM ${PYTHON_IMAGE} AS builder
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/venv/bin:$PATH
WORKDIR /build
RUN python -m venv /opt/venv
COPY pyproject.toml ./
# Third-party dependencies get their own layer so it stays cached when only source changes.
RUN python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml', 'rb'))['project']['dependencies']))" > requirements.txt \
 && pip install --no-cache-dir -r requirements.txt
COPY src/common src/common
COPY src/agents src/agents
COPY src/api src/api
# The shared pyproject declares the ingest console script; its package is not in this image.
RUN pip install --no-cache-dir --no-deps . \
 && rm /opt/venv/bin/flamescope-ingest

FROM ${PYTHON_IMAGE} AS runtime
ARG VERSION=0.1.0
ARG SOURCE_URL=""
LABEL org.opencontainers.image.title="flamescope-api" \
      org.opencontainers.image.description="FlameScope REST and SSE API (FastAPI)" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.version="${VERSION}"
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATA_DIR=/app/src/data \
    RAW_DIR=/data/raw
RUN groupadd --gid 10001 flamescope \
 && useradd --uid 10001 --gid 10001 --home-dir /app --no-create-home --shell /usr/sbin/nologin flamescope \
 && mkdir -p /data/raw \
 && chown 10001:10001 /data/raw
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY src/data src/data
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=4)"]
CMD ["uvicorn", "flamescope_api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
