;entryDy=0;" edge="1" parent="1" source="9765-24" target="9765-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="9765-46" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.8828;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="9765-21" target="9765-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="9765-47" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8828;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="9765-25" target="9765-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="9765-48" value="HTTPS" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="9765-26" target="9765-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="9765-49" value="SQL" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="9765-28" target="9765-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="9765-50" value="harvest" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="9765-31" target="9765-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="9765-51" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.2500;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="9765-31" target="9765-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="9765-52" value="extract / embed" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.8500;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="9765-31" target="9765-33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="570"/></Array></mxGeometry></mxCell><mxCell id="9765-53" value="write" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.9500;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="9765-31" target="9765-34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="656"/></Array></mxGeometry></mxCell><mxCell id="9765-54" value="&lt;b&gt;Prompt files (modular, one per agent):&lt;/b&gt; prompts/extractor.md, scorer.md, comparator.md, scenario.md, insight_qa.md, earth_apps.md, plus prompts/shared/schema_investigation.json and rubric.yaml.&lt;br&gt;&lt;b&gt;Contract:&lt;/b&gt; every agent returns JSON validated by Pydantic; free text only inside fields that carry a source reference. InsightService calls CitationVerifier before returning an answer; services reach the DB only through Repositories." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1480" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p80979" name="04 Ingestion Pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1187-2" value="&lt;b style='font-size:20px'&gt;Ingestion Pipeline - PSI to curated knowledge&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;Offline, repeatable, idempotent. Runs once before the demo and again when PSI adds data&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="1187-3" value="&lt;b&gt;1 Discover&lt;/b&gt;&lt;br&gt;List the 24 Combustion Science investigations and their folder trees" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="330" height="90" as="geometry"/></mxCell><mxCell id="1187-4" value="&lt;b&gt;2 Harvest&lt;/b&gt;&lt;br&gt;Fetch overview pages, science documents, publication lists; raw data only as file manifests" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="410" y="90" width="330" height="90" as="geometry"/></mxCell><mxCell id="1187-5" value="&lt;b&gt;3 Parse&lt;/b&gt;&lt;br&gt;HTML to text, PDF to text + tables, CSV / XLSX headers and row samples" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="330" height="90" as="geometry"/></mxCell><mxCell id="1187-6" value="&lt;b&gt;4 Extract&lt;/b&gt;&lt;br&gt;Extractor agent fills the investigation card schema; each field has source + confidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1150" y="90" width="330" height="90" as="geometry"/></mxCell><mxCell id="1187-7" value="&lt;b&gt;5 Normalize&lt;/b&gt;&lt;br&gt;Units (psi, kPa, % O2, cm/s), fuel taxonomy, hardware links (CIR, MSG, MDCA, ACME, SPICE duct)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1150" y="420" width="330" height="90" as="geometry"/></mxCell><mxCell id="1187-8" value="&lt;b&gt;6 Score&lt;/b&gt;&lt;br&gt;Scorer agent applies rubric per lens; deterministic weighted total" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="780" y="420" width="330" height="90" as="geometry"/></mxCell><mxCell id="1187-9" value="&lt;b&gt;7 Index&lt;/b&gt;&lt;br&gt;Chunk documents, embed, store in pgvector with investigation + section metadata" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="410" y="420" width="330" height="90" as="geometry"/></mxCell><mxCell id="1187-10" value="&lt;b&gt;8 Review&lt;/b&gt;&lt;br&gt;Low-confidence or conflicting fields go to a review list; curator fixes via YAML override" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="330" height="90" as="geometry"/></mxCell><mxCell id="1187-11" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="1187-3" target="1187-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-12" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="1187-4" target="1187-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-13" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="1187-5" target="1187-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-14" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="1187-6" target="1187-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1515" y="135"/><mxPoint x="1515" y="465"/></Array></mxGeometry></mxCell><mxCell id="1187-15" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="1187-7" target="1187-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-16" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="1187-8" target="1187-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-17" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="1187-9" target="1187-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-18" value="&lt;b&gt;Artifact:&lt;/b&gt; investigations.yaml&lt;br&gt;id, name, PSI URL, folder manifest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="330" height="70" as="geometry"/></mxCell><mxCell id="1187-19" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="1187-3" target="1187-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-20" value="&lt;b&gt;Artifact:&lt;/b&gt; raw/ per investigation&lt;br&gt;html, pdf, manifests (sizes, paths)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="410" y="205" width="330" height="70" as="geometry"/></mxCell><mxCell id="1187-21" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="1187-4" target="1187-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-22" value="&lt;b&gt;Artifact:&lt;/b&gt; parsed/ text + table JSON&lt;br&gt;section offsets kept for citation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="205" width="330" height="70" as="geometry"/></mxCell><mxCell id="1187-23" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="1187-5" target="1187-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-24" value="&lt;b&gt;Artifact:&lt;/b&gt; card.json (schema v1)&lt;br&gt;objectives, fuels, conditions, sensors, findings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1150" y="205" width="330" height="70" as="geometry"/></mxCell><mxCell id="1187-25" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="1187-6" target="1187-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-26" value="&lt;b&gt;Artifact:&lt;/b&gt; normalized rows&lt;br&gt;investigation, test_run, condition, fuel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1150" y="535" width="330" height="70" as="geometry"/></mxCell><mxCell id="1187-27" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="1187-7" target="1187-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-28" value="&lt;b&gt;Artifact:&lt;/b&gt; relevance_score rows&lt;br&gt;criterion, value 0-5, evidence, rationale" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="535" width="330" height="70" as="geometry"/></mxCell><mxCell id="1187-29" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="1187-8" target="1187-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-30" value="&lt;b&gt;Artifact:&lt;/b&gt; chunk rows + vectors&lt;br&gt;hybrid search (BM25 + vector)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="410" y="535" width="330" height="70" as="geometry"/></mxCell><mxCell id="1187-31" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="1187-9" target="1187-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-32" value="&lt;b&gt;Artifact:&lt;/b&gt; overrides/*.yaml&lt;br&gt;human corrections win over LLM output" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="330" height="70" as="geometry"/></mxCell><mxCell id="1187-33" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="1187-10" target="1187-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1187-34" value="&lt;b&gt;Scale guard:&lt;/b&gt; only documents and metadata are downloaded (MB-GB). Video, image stacks and large sensor files stay in PSI and are referenced by path, size and type so users can jump to them. Optional: sample a few CSV sensor files per investigation to expose column names and ranges for the Data Extract tab." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1440" height="95" as="geometry"/></mxCell><mxCell id="1187-35" value="&lt;b&gt;Known structure to seed the linker (from the challenge text):&lt;/b&gt; ACME = six gaseous-fuel experiments in the CIR (incl. BRE, CFI-G, E-FIELD Flames). FLEX, FLEX-2, CFI = liquid droplets in MDCA / CIR. BASS, BASS-II, SPICE, SLICE = solid and gaseous fuels in the MSG using the SPICE flow duct. SAME, SAME-R = smoke detection; the same instrument family appears in DAFT, DAFT-2 for dust. No partial-gravity data in PSI yet (LUCI, FM2 expected) - flag as a gap, bound with 0 g and 1 g." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1440" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p77941" name="05 Data Model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6619-2" value="&lt;b style='font-size:20px'&gt;Data Model - curated knowledge schema&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;PostgreSQL; every extracted value keeps source_ref and confidence&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="6619-3" value="&lt;b&gt;Project&lt;/b&gt;&lt;hr&gt;id, name (e.g. ACME)&lt;br&gt;description" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="280" height="130" as="geometry"/></mxCell><mxCell id="6619-4" value="&lt;b&gt;Hardware&lt;/b&gt;&lt;hr&gt;id, name (CIR, MSG, MDCA,&lt;br&gt;ACME insert, SPICE duct)&lt;br&gt;facility, capabilities" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="280" height="130" as="geometry"/></mxCell><mxCell id="6619-5" value="&lt;b&gt;Publication&lt;/b&gt;&lt;hr&gt;doi, title, authors, year&lt;br&gt;abstract, key_findings[]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1020" y="90" width="280" height="130" as="geometry"/></mxCell><mxCell id="6619-6" value="&lt;b&gt;Chunk&lt;/b&gt;&lt;hr&gt;id, investigation_id&lt;br&gt;doc_ref, section, offsets&lt;br&gt;text, embedding vector&lt;br&gt;tsvector (keyword search)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="280" height="150" as="geometry"/></mxCell><mxCell id="6619-7" value="&lt;b&gt;Investigation&lt;/b&gt;&lt;hr&gt;id, acronym, title, psi_url, status, years, platform (ISS, drop tower, ...), gravity_level&lt;br&gt;objectives[], approach, summary, fire_safety_tags[]&lt;br&gt;data_volume, file_manifest_ref, card_version, reviewed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="290" width="920" height="170" as="geometry"/></mxCell><mxCell id="6619-8" value="&lt;b&gt;Finding&lt;/b&gt;&lt;hr&gt;id, investigation_id&lt;br&gt;statement, category&lt;br&gt;source_ref (doc / DOI)&lt;br&gt;confidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1340" y="290" width="280" height="150" as="geometry"/></mxCell><mxCell id="6619-9" value="&lt;b&gt;RelevanceScore&lt;/b&gt;&lt;hr&gt;investigation_id, lens&lt;br&gt;criterion, value (0-5)&lt;br&gt;evidence_ref, rationale&lt;br&gt;rubric_version, total" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="280" height="170" as="geometry"/></mxCell><mxCell id="6619-10" value="&lt;b&gt;Measurement&lt;/b&gt;&lt;hr&gt;id, investigation_id&lt;br&gt;sensor / instrument&lt;br&gt;quantity, units, file pattern&lt;br&gt;also_used_in (SAME / DAFT)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="540" width="280" height="170" as="geometry"/></mxCell><mxCell id="6619-11" value="&lt;b&gt;TestRun / Sample&lt;/b&gt;&lt;hr&gt;id, investigation_id, label&lt;br&gt;sample_folder_ref&lt;br&gt;varied_parameters (jsonb)&lt;br&gt;fixed_parameters (jsonb)&lt;br&gt;outcome (ignition, spread&lt;br&gt;rate, extinction, smoke point)&lt;br&gt;data_files (jsonb)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="540" width="280" height="190" as="geometry"/></mxCell><mxCell id="6619-12" value="&lt;b&gt;Condition&lt;/b&gt;&lt;hr&gt;test_run_id&lt;br&gt;o2_fraction, diluent&lt;br&gt;pressure_kpa&lt;br&gt;flow_speed_cm_s, flow_dir&lt;br&gt;gravity, e_field&lt;br&gt;source_ref, confidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1020" y="540" width="280" height="190" as="geometry"/></mxCell><mxCell id="6619-13" value="&lt;b&gt;EarthApplication&lt;/b&gt;&lt;hr&gt;id, title, sector&lt;br&gt;linked findings&lt;br&gt;maturity, references" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1340" y="540" width="280" height="150" as="geometry"/></mxCell><mxCell id="6619-14" value="&lt;b&gt;Fuel&lt;/b&gt;&lt;hr&gt;id, name, phase&lt;br&gt;(gas / liquid / solid)&lt;br&gt;material class, geometry&lt;br&gt;dimensions, burner type" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="800" width="280" height="150" as="geometry"/></mxCell><mxCell id="6619-15" value="1..n" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1522;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-3" target="6619-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6619-16" value="n..m" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-4" target="6619-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6619-17" value="1..n" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.8478;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-7" target="6619-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6619-18" value="1..n" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.0000;exitY=0.4412;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-7" target="6619-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6619-19" value="1..n" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.4412;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-7" target="6619-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6619-20" value="n..m" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-8" target="6619-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6619-21" value="1..n" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.1522;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-7" target="6619-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6619-22" value="1..n" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-7" target="6619-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6619-23" value="1..1" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-11" target="6619-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6619-24" value="n..1" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-11" target="6619-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6619-25" value="1..n" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.0435;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="6619-7" target="6619-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="500"/><mxPoint x="200" y="500"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p30157" name="06 Relevance Scoring"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7484-2" value="&lt;b style='font-size:20px'&gt;Relevance Scoring and Ranking&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;LLM rates criteria against a rubric with evidence; the arithmetic is deterministic and user-tunable&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="7484-3" value="&lt;b&gt;Lens A - Habitat fire-safety relevance&lt;/b&gt;&lt;br&gt;&lt;i&gt;Maps to objective 1&lt;/i&gt;&lt;hr&gt;- Fuel realism: solid cabin materials &gt; liquids &gt; gases&lt;br&gt;- Atmosphere: closeness to 30%+ O2, ~10.2 psi and lower&lt;br&gt;- Flow regime: low-speed ventilation flows, quiescent&lt;br&gt;- Phenomenon: ignition, flame spread, flammability limits&lt;br&gt;- Gravity relevance: usable to bound lunar / Mars g" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="460" height="250" as="geometry"/></mxCell><mxCell id="7484-4" value="&lt;b&gt;Lens B - Predictive-modeling value&lt;/b&gt;&lt;br&gt;&lt;i&gt;Maps to objective 2&lt;/i&gt;&lt;hr&gt;- Quantitative outputs: spread rate, extinction limits, burn rate&lt;br&gt;- Parameter sweep breadth (O2, pressure, flow, size)&lt;br&gt;- Well-defined geometry and boundary conditions&lt;br&gt;- Data accessibility: tabular, documented, units&lt;br&gt;- Publications with validated models / correlations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="530" y="80" width="460" height="250" as="geometry"/></mxCell><mxCell id="7484-5" value="&lt;b&gt;Lens C - Controls and equipment value&lt;/b&gt;&lt;br&gt;&lt;i&gt;Maps to objective 3&lt;/i&gt;&lt;hr&gt;- Detection: smoke / aerosol characterization (SAME, SAME-R)&lt;br&gt;- Suppression / extinction behaviour&lt;br&gt;- Material screening implications&lt;br&gt;- Post-fire: cool flames, re-ignition, toxic products&lt;br&gt;- Hardware / sensor heritage reusable in new systems" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="460" height="250" as="geometry"/></mxCell><mxCell id="7484-6" value="&lt;b&gt;Scorer agent (offline)&lt;/b&gt;&lt;br&gt;For each criterion: value 0-5, rationale, evidence_ref.&lt;br&gt;No evidence = value null, not a guess" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="330" height="110" as="geometry"/></mxCell><mxCell id="7484-7" value="&lt;b&gt;Deterministic aggregate&lt;/b&gt;&lt;br&gt;lens_score = sum(w_i * v_i) / sum(w_i)&lt;br&gt;overall = weighted mean of lenses&lt;br&gt;null criteria reduce confidence, not score" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430" y="370" width="330" height="110" as="geometry"/></mxCell><mxCell id="7484-8" value="&lt;b&gt;User controls&lt;/b&gt;&lt;br&gt;weight sliders per lens / criterion&lt;br&gt;presets: Lunar habitat, Spacecraft cabin, Modeler" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="370" width="330" height="110" as="geometry"/></mxCell><mxCell id="7484-9" value="&lt;b&gt;Explainability&lt;/b&gt;&lt;br&gt;score breakdown bar + evidence drawer with PSI / DOI links" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1210" y="370" width="270" height="110" as="geometry"/></mxCell><mxCell id="7484-10" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="7484-6" target="7484-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7484-11" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="7484-7" target="7484-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7484-12" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="7484-8" target="7484-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7484-13" value="&lt;b&gt;Scenario matching (Scenario Lab)&lt;/b&gt;&lt;hr&gt;Input: O2 %, pressure, gravity, airflow, material class.&lt;br&gt;1. Normalize each dimension to 0-1 over the range present in the catalog.&lt;br&gt;2. Distance = weighted L1 between scenario and each test-run condition.&lt;br&gt;3. Aggregate to investigation level (best and median run).&lt;br&gt;4. Report coverage: which dimensions are inside tested ranges, which are extrapolated.&lt;br&gt;5. Gravity: PSI has no partial-g runs - show 0 g and 1 g evidence as bounds and name E-FIELD Flames as the partial-g analogue; label clearly as a data gap." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="700" height="230" as="geometry"/></mxCell><mxCell id="7484-14" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;hr&gt;- Scores are relative ordering aids, not safety certifications - stated in the UI.&lt;br&gt;- Every criterion value is traceable to a chunk or DOI; the verifier rejects unsupported rationales.&lt;br&gt;- Rubric and weights are versioned (rubric.yaml) so rankings are reproducible.&lt;br&gt;- Curator overrides are stored separately and shown with a badge.&lt;br&gt;- Highest-O2 evidence (CFI-G, up to 85% O2 from the burner) is tagged so high-O2 scenarios surface it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="780" y="520" width="700" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p53944" name="07 Flow - Ingestion"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7552-2" value="&lt;b style='font-size:20px'&gt;Call Flow - Ingestion of one investigation&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="7552-3" value="CLI / Job" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="160" height="50" as="geometry"/></mxCell><mxCell id="7552-4" value="Harvester" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="275" y="80" width="160" height="50" as="geometry"/></mxCell><mxCell id="7552-5" value="Parser" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="80" width="160" height="50" as="geometry"/></mxCell><mxCell id="7552-6" value="Extractor agent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="705" y="80" width="160" height="50" as="geometry"/></mxCell><mxCell id="7552-7" value="Scorer agent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="80" width="160" height="50" as="geometry"/></mxCell><mxCell id="7552-8" value="LLM gateway" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1135" y="80" width="160" height="50" as="geometry"/></mxCell><mxCell id="7552-9" value="DB + vectors" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="80" width="160" height="50" as="geometry"/></mxCell><mxCell id="7552-10" value="" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#444444;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="130" as="sourcePoint"/><mxPoint x="140" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7552-11" value="" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#444444;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="130" as="sourcePoint"/><mxPoint x="355" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7552-12" value="" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#444444;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="130" as="sourcePoint"/><mxPoint x="570" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7552-13" value="" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#444444;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785" y="130" as="sourcePoint"/><mxPoint x="785" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7552-14" value="" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;ve