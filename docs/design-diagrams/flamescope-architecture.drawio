ze=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1223" y="775" width="200" height="30" as="geometry"/></mxCell><mxCell id="4324-32" value="16. CSV / JSON + data dictionary" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#444444;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215" y="834" as="sourcePoint"/><mxPoint x="570" y="834" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4324-33" value="17. download" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#444444;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="878" as="sourcePoint"/><mxPoint x="355" y="878" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p83675" name="11 UI Views"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="13-2" value="&lt;b style='font-size:20px'&gt;Dashboard Views - one tab per user job&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;Global header: search, fuel / hardware / O2 filters, lens preset selector&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="13-3" value="&lt;b&gt;1 Explorer&lt;/b&gt;&lt;hr&gt;Grid of investigation cards: objectives, fuel + geometry, O2 / pressure / flow ranges, sensors, hardware badge. Facet filters. Click opens detail with runs table, publications, PSI links." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="340" height="200" as="geometry"/></mxCell><mxCell id="13-4" value="&lt;b&gt;2 Ranking&lt;/b&gt;&lt;hr&gt;Three lens tabs + overall. Stacked score bars per criterion, weight sliders, presets. Evidence drawer per score." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="410" y="90" width="340" height="200" as="geometry"/></mxCell><mxCell id="13-5" value="&lt;b&gt;3 Compare&lt;/b&gt;&lt;hr&gt;Pick 2-4 investigations (or runs inside one). Matrix: same vs different attributes, shared hardware view (CIR / MSG / MDCA), narrative summary." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="340" height="200" as="geometry"/></mxCell><mxCell id="13-6" value="&lt;b&gt;4 Scenario Lab&lt;/b&gt;&lt;hr&gt;Sliders: O2 %, pressure, gravity, airflow, material. Shows closest tests, parameter coverage chart, 0 g / 1 g bounding, explicit partial-g gap notice." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1150" y="90" width="340" height="200" as="geometry"/></mxCell><mxCell id="13-7" value="&lt;b&gt;5 Data Extract&lt;/b&gt;&lt;hr&gt;Query builder over test runs. Preview table, column dictionary, export CSV / JSON with provenance for predictive modeling." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="340" height="200" as="geometry"/></mxCell><mxCell id="13-8" value="&lt;b&gt;6 Safety Tech&lt;/b&gt;&lt;hr&gt;Research grouped by control type: detection (smoke / aerosol), suppression, material screening, post-fire. Links findings to equipment ideas." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="410" y="320" width="340" height="200" as="geometry"/></mxCell><mxCell id="13-9" value="&lt;b&gt;7 Earth Apps&lt;/b&gt;&lt;hr&gt;Add-on: spin-offs such as fine water mist extinguishers, smoke detection, firefighter gear, mapped to source investigations." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="780" y="320" width="340" height="200" as="geometry"/></mxCell><mxCell id="13-10" value="&lt;b&gt;8 Ask&lt;/b&gt;&lt;hr&gt;Chat over the curated corpus. Streamed answers, inline citations, suggested follow-ups, 'show cards used'." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1150" y="320" width="340" height="200" as="geometry"/></mxCell><mxCell id="13-11" value="&lt;b&gt;Visual vocabulary:&lt;/b&gt; parameter-space scatter (O2 vs pressure, colored by fuel phase), heatmap for comparison matrix, radar or stacked bars for lens scores, timeline of investigations by year, hardware lineage graph (project - hardware - investigation). Every chart element is clickable through to the investigation card and on to PSI." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1450" height="120" as="geometry"/></mxCell><mxCell id="13-12" value="&lt;b&gt;Demo path (3 min):&lt;/b&gt; Ranking with Lunar habitat preset - open top card and evidence - Compare BASS-II vs a droplet study - Scenario Lab at 34% O2 showing the partial-g gap - Extract CSV - Ask a question - Earth Apps." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1450" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p64197" name="12 Deployment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5373-2" value="&lt;b style='font-size:20px'&gt;Deployment View - containers, Helm, OpenShift / Kubernetes&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;Same images run locally with docker compose for the hackathon&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="5373-3" value="OpenShift project: flamescope  (Helm release)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;verticalAlign=top;fontStyle=1;fontSize=13;dashed=1;arcSize=3;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="640" as="geometry"/></mxCell><mxCell id="5373-4" value="&lt;b&gt;Route / Ingress&lt;/b&gt;&lt;br&gt;TLS edge termination" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="240" height="70" as="geometry"/></mxCell><mxCell id="5373-5" value="&lt;b&gt;Deployment: ui&lt;/b&gt;&lt;br&gt;nginx serving React build&lt;br&gt;proxies /api" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="240" height="90" as="geometry"/></mxCell><mxCell id="5373-6" value="&lt;b&gt;Deployment: api&lt;/b&gt;&lt;br&gt;FastAPI + uvicorn, 2 replicas&lt;br&gt;readiness / liveness probes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="250" width="260" height="90" as="geometry"/></mxCell><mxCell id="5373-7" value="&lt;b&gt;StatefulSet: postgres&lt;/b&gt;&lt;br&gt;pgvector image&lt;br&gt;PVC 10-20 Gi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="750" y="250" width="300" height="90" as="geometry"/></mxCell><mxCell id="5373-8" value="&lt;b&gt;ConfigMap&lt;/b&gt;&lt;br&gt;rubric.yaml, prompts/, feature flags" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="240" height="90" as="geometry"/></mxCell><mxCell id="5373-9" value="&lt;b&gt;Optional Deployment: llm&lt;/b&gt;&lt;br&gt;llama.cpp / vLLM (GPU node)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="260" height="90" as="geometry"/></mxCell><mxCell id="5373-10" value="&lt;b&gt;NetworkPolicy + ServiceAccount&lt;/b&gt;&lt;br&gt;api to db; api / job egress only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="750" y="420" width="300" height="90" as="geometry"/></mxCell><mxCell id="5373-11" value="&lt;b&gt;Secret&lt;/b&gt;&lt;br&gt;LLM API key, DB credentials" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="240" height="80" as="geometry"/></mxCell><mxCell id="5373-12" value="&lt;b&gt;Job: ingest&lt;/b&gt;&lt;br&gt;on install / on demand&lt;br&gt;(CronJob optional)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="260" height="80" as="geometry"/></mxCell><mxCell id="5373-13" value="&lt;b&gt;PVC: raw-docs&lt;/b&gt;&lt;br&gt;harvested documents + manifests" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="750" y="560" width="300" height="80" as="geometry"/></mxCell><mxCell id="5373-14" value="&lt;b&gt;Users (browser)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1220" y="130" width="280" height="70" as="geometry"/></mxCell><mxCell id="5373-15" value="&lt;b&gt;Hosted LLM API&lt;/b&gt; (alternative)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1220" y="270" width="280" height="70" as="geometry"/></mxCell><mxCell id="5373-16" value="&lt;b&gt;NASA PSI / AWS open data&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1220" y="430" width="280" height="70" as="geometry"/></mxCell><mxCell id="5373-17" value="HTTPS" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="5373-14" target="5373-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5373-18" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="5373-4" target="5373-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5373-19" value="/api" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="5373-5" target="5373-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5373-20" value="5432" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="5373-6" target="5373-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5373-21" value="self-hosted" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="5373-6" target="5373-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5373-22" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.6875;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.6875;entryDx=0;entryDy=0;" edge="1" parent="1" source="5373-12" target="5373-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5373-23" value="write" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.0000;exitY=0.2500;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.7778;entryDx=0;entryDy=0;" edge="1" parent="1" source="5373-12" target="5373-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="580"/><mxPoint x="705" y="320"/></Array></mxGeometry></mxCell><mxCell id="5373-24" value="HTTPS (hosted option)" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.7692;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="5373-6" target="5373-15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="225"/><mxPoint x="1180" y="225"/><mxPoint x="1180" y="305"/></Array></mxGeometry></mxCell><mxCell id="5373-25" value="harvest (HTTPS)" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="5373-12" target="5373-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="680"/><mxPoint x="1180" y="680"/><mxPoint x="1180" y="465"/></Array></mxGeometry></mxCell><mxCell id="5373-26" value="&lt;b&gt;Repo layout:&lt;/b&gt; ui/ (React) - api/ (FastAPI, services, agents) - ingest/ (pipeline) - prompts/ (one file per agent) - data/overrides/ - deploy/docker (Dockerfile.ui, Dockerfile.api, Dockerfile.ingest, compose.yaml) - deploy/helm/flamescope (values.yaml: llm.provider, llm.baseUrl, ingest.enabled, route.host) - docs/ (this file) - README.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1460" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p36271" name="13 Build Plan (48h)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="434-2" value="&lt;b style='font-size:20px'&gt;Build Plan - 48-hour hackathon slices&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;Each slice ends with something demoable; cut from the bottom if time runs out&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="434-3" value="&lt;b&gt;H0-4  Foundation&lt;/b&gt;&lt;hr&gt;Repo skeleton, compose, DB schema, investigation list (24) seeded by hand from PSI overviews" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="276" height="140" as="geometry"/></mxCell><mxCell id="434-4" value="&lt;b&gt;H4-12  Ingestion MVP&lt;/b&gt;&lt;hr&gt;Harvest overviews + key docs, extractor agent to cards, review + overrides for accuracy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="336" y="90" width="276" height="140" as="geometry"/></mxCell><mxCell id="434-5" value="&lt;b&gt;H8-16  Explorer + API&lt;/b&gt;&lt;hr&gt;Catalog endpoints, card grid, filters, detail page with PSI links" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="632" y="90" width="276" height="140" as="geometry"/></mxCell><mxCell id="434-6" value="&lt;b&gt;H12-20  Scoring + Ranking&lt;/b&gt;&lt;hr&gt;Rubric, scorer agent, deterministic aggregate, ranking UI with evidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="928" y="90" width="276" height="140" as="geometry"/></mxCell><mxCell id="434-7" value="&lt;b&gt;H18-26  Compare&lt;/b&gt;&lt;hr&gt;Diff matrix, hardware lineage, comparator narrative" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1224" y="90" width="276" height="140" as="geometry"/></mxCell><mxCell id="434-8" value="&lt;b&gt;H22-30  Ask (RAG)&lt;/b&gt;&lt;hr&gt;Chunk + embed, hybrid search, cited answers, verifier" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="276" height="140" as="geometry"/></mxCell><mxCell id="434-9" value="&lt;b&gt;H28-36  Scenario Lab + Extract&lt;/b&gt;&lt;hr&gt;Condition matching, coverage chart, g-bounding notice, CSV / JSON export" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="336" y="260" width="276" height="140" as="geometry"/></mxCell><mxCell id="434-10" value="&lt;b&gt;H34-40  Safety Tech + Earth Apps&lt;/b&gt;&lt;hr&gt;Group findings by control type; spin-off mapping" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="632" y="260" width="276" height="140" as="geometry"/></mxCell><mxCell id="434-11" value="&lt;b&gt;H40-46  Polish + deploy&lt;/b&gt;&lt;hr&gt;Helm install, demo script, README, record video" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="928" y="260" width="276" height="140" as="geometry"/></mxCell><mxCell id="434-12" value="&lt;b&gt;H46-48  Submit&lt;/b&gt;&lt;hr&gt;Project page, links, 30-second pitch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1224" y="260" width="276" height="140" as="geometry"/></mxCell><mxCell id="434-13" value="&lt;b&gt;Must-have (judged against the three objectives)&lt;/b&gt;&lt;hr&gt;- Accurate cards for all 24 investigations&lt;br&gt;- Ranking with evidence (objective 1)&lt;br&gt;- Model-ready extract (objective 2)&lt;br&gt;- Safety-tech grouping (objective 3)&lt;br&gt;- Cited Ask" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="720" height="200" as="geometry"/></mxCell><mxCell id="434-14" value="&lt;b&gt;Risks and mitigations&lt;/b&gt;&lt;hr&gt;- PSI access friction or slow downloads: seed from overview pages first, add documents incrementally&lt;br&gt;- LLM extraction errors: confidence + human overrides, show sources&lt;br&gt;- Sparse numeric data in docs: fall back to ranges and qualitative outcomes&lt;br&gt;- Time: Compare narrative, Earth Apps and self-hosted LLM are the first cuts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="790" y="450" width="720" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>