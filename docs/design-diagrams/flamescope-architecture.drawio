br&gt;comparator.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="464" width="136" height="60" as="geometry"/></mxCell><mxCell id="9765-23" value="&lt;b&gt;Scenario&lt;/b&gt;&lt;br&gt;scenario.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="568" y="464" width="136" height="60" as="geometry"/></mxCell><mxCell id="9765-24" value="&lt;b&gt;Insight QA&lt;/b&gt;&lt;br&gt;insight_qa.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="716" y="464" width="136" height="60" as="geometry"/></mxCell><mxCell id="9765-25" value="&lt;b&gt;Earth apps&lt;/b&gt;&lt;br&gt;earth_apps.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="864" y="464" width="136" height="60" as="geometry"/></mxCell><mxCell id="9765-26" value="&lt;b&gt;LLMGateway&lt;/b&gt; - provider adapter, timeout, response cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="548" width="580" height="44" as="geometry"/></mxCell><mxCell id="9765-27" value="&lt;b&gt;CitationVerifier&lt;/b&gt;&lt;br&gt;claim maps to a stored chunk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="420" y="622" width="180" height="68" as="geometry"/></mxCell><mxCell id="9765-28" value="&lt;b&gt;Repositories&lt;/b&gt;&lt;br&gt;Investigation, Run, Score, Chunk (SQLAlchemy + pgvector)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="622" width="380" height="68" as="geometry"/></mxCell><mxCell id="9765-29" value="Stores and jobs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;verticalAlign=top;fontStyle=1;fontSize=13;dashed=1;arcSize=3;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1080" y="80" width="440" height="640" as="geometry"/></mxCell><mxCell id="9765-30" value="&lt;b&gt;NASA PSI / AWS open data / DOIs&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="400" height="56" as="geometry"/></mxCell><mxCell id="9765-31" value="&lt;b&gt;flamescope-ingest (Job / CLI)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Harvester - Parser - ExtractorAgent (extractor.md)&lt;br&gt;ScorerAgent (scorer.md) - Linker - Embedder&lt;br&gt;Review queue for low-confidence fields&lt;br&gt;&lt;br&gt;Idempotent per investigation; versioned cards" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1100" y="206" width="400" height="180" as="geometry"/></mxCell><mxCell id="9765-32" value="&lt;b&gt;Raw document store&lt;/b&gt;&lt;br&gt;PVC / S3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="416" width="200" height="56" as="geometry"/></mxCell><mxCell id="9765-33" value="&lt;b&gt;LLM + embedding endpoint&lt;/b&gt;&lt;br&gt;OpenAI-compatible API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1100" y="536" width="300" height="68" as="geometry"/></mxCell><mxCell id="9765-34" value="&lt;b&gt;PostgreSQL + pgvector&lt;/b&gt;&lt;br&gt;catalog, runs, scores, chunks" style="rounde